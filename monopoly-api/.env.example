# Copy to .env for local development. On Render these are set in the dashboard / render.yaml.
FLASK_APP=app.py
# "production" selects ProductionConfig (DEBUG off); anything else uses DevelopmentConfig
FLASK_ENV=development

# Postgres (Neon gives a URL like postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monopoly
# Redis for server-side sessions (Upstash gives a rediss:// URL)
REDIS_URL=redis://localhost:6379
SESSION_TYPE=redis

JWT_SECRET_KEY=change-me
SECRET_KEY=change-me

# Origin of the React UI, used for CORS and Socket.IO
MONOPOLY_UI_URL=http://localhost:3000

API_TITLE=Monopoly Deal API
API_VERSION=1.0
DOCUMENTATION=/documentation/
JWT_ACCESS_TOKEN_EXPIRES=1
JWT_REFRESH_TOKEN_EXPIRES=24
PERMANENT_SESSION_LIFETIME=24
